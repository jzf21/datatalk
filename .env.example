# --- OpenAI (or any OpenAI-compatible endpoint, e.g. Nebius Token Factory) ---
OPENAI_API_KEY=sk-...
# Leave empty for OpenAI. For a compatible provider, set its base URL, e.g.
# https://api.tokenfactory.nebius.com/v1/
OPENAI_BASE_URL=
# Chat model for the report/analysis agent loop. MUST support tool/function calling.
OPENAI_MODEL=gpt-4.1
# Model used to embed user suggestions for few-shot memory retrieval.
OPENAI_EMBED_MODEL=text-embedding-3-small

# Model for the one-click data-documentation agent (Settings -> Data context).
# It runs rarely, agentically, over a whole warehouse, and its output then lands
# in every later prompt -- so it is worth more than the report loop's model.
# MUST support tool/function calling. Empty = use OPENAI_MODEL.
OPENAI_DOCS_MODEL=
# Optional: a separate endpoint and key just for that model, e.g. reports on a
# self-hosted model while documentation runs on a frontier one. Both empty =
# reuse the OPENAI_BASE_URL / OPENAI_API_KEY above.
OPENAI_DOCS_BASE_URL=
OPENAI_DOCS_API_KEY=

# Model for the dashboard author. One call per dashboard, and the most
# structurally demanding one in the pipeline: it must emit a whole grid as a
# single valid JSON object referencing only real dataset ids and columns, and a
# malformed reply costs the entire dashboard. Worth a stronger model even when
# the query loop stays cheap. Does NOT need tool calling. Empty = use
# OPENAI_MODEL.
OPENAI_AUTHOR_MODEL=
# Optional: a separate endpoint and key just for that model. Both empty = reuse
# the OPENAI_BASE_URL / OPENAI_API_KEY above.
OPENAI_AUTHOR_BASE_URL=
OPENAI_AUTHOR_API_KEY=
# Completion cap for the author and insight calls. 0 = let the provider decide.
# Set this when an OpenAI-compatible server's default completion cap silently
# truncates large dashboards (the stream will say "cut off" when that happens).
OPENAI_AUTHOR_MAX_TOKENS=0
# Transport resilience for every OpenAI client this process builds: how many
# times the SDK retries a 429/5xx/connection error (with backoff), and how many
# seconds one completion may take before it is abandoned and retried.
OPENAI_MAX_RETRIES=5
OPENAI_TIMEOUT_SECONDS=120
# Completion cap for the analyze/critique calls. 0 = let the provider decide.
OPENAI_ANALYZE_MAX_TOKENS=0

# --- Langfuse (LLM observability) ---
# Optional. With no key pair, tracing is off and the OpenAI call path is
# byte-identical to before the feature existed. Keys: Langfuse project ->
# Settings -> API Keys. Free cloud account at https://langfuse.com/cloud
#
# Note the Langfuse SDK reads os.environ and never sees this file, so DataTalk
# builds the client explicitly from these values (datatalk/observability.py).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Region. Empty = EU cloud (https://cloud.langfuse.com). US cloud is
# https://us.cloud.langfuse.com; a self-hosted deployment is its own URL.
LANGFUSE_BASE_URL=
# Master switch, so a deployment can keep its keys and still turn tracing off.
LANGFUSE_TRACING_ENABLED=true
# Keeps development runs out of production dashboards and evaluations.
# Conventionally: production | staging | development.
LANGFUSE_TRACING_ENVIRONMENT=development
# 1.0 traces every run. Lower it on a busy deployment.
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_DEBUG=false
# Whether warehouse row VALUES may be recorded on run_sql observations. false
# keeps the SQL, the columns and the row count -- enough to see what the agent
# asked and how much came back -- but not the tenant's numbers. It cannot cover
# the prompts themselves: whatever the model was shown is inherently part of a
# generation, so on sensitive data pair this with Langfuse's own masking.
LANGFUSE_CAPTURE_ROW_VALUES=true

# --- ClickHouse (bootstrap only) ---
# NOT any org's warehouse. An org's data sources -- any number of them, each
# ClickHouse or Postgres -- are stored per-org in Postgres and managed from
# Settings -> Data sources in the UI. These values are read in exactly two
# places: `datatalk-check`, and seeding a first source for an org via
# `datatalk-import-sqlite --bootstrap-warehouse`. A request never reaches them;
# an org with no source of its own gets a 409, never someone else's data.
#
# Prefer a READ-ONLY ClickHouse user here as defense-in-depth: the LLM writes
# SQL. (Postgres sources need no such care -- the adapter opens every session
# read-only, so the server refuses writes whatever the SQL says.)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
# Set to true if your ClickHouse is served over HTTPS (e.g. ClickHouse Cloud, port 8443).
CLICKHOUSE_SECURE=false

# --- Agent guardrails ---
# Ceilings every data source inherits unless it overrides them.
# Default LIMIT injected into exploratory SELECTs that lack one.
SQL_DEFAULT_LIMIT=1000
# Hard cap on rows returned to the model from any single query.
SQL_MAX_ROWS=5000
# Per-query timeout (seconds).
SQL_TIMEOUT_SECONDS=30

# --- Introspection ---
# Defaults for every source; each source can narrow them.
# On ClickHouse INTROSPECT_DATABASES is a database allowlist; on Postgres one
# source sees one database, so it is a schema allowlist.
# How many sample rows to pull per table when building schema context.
INTROSPECT_SAMPLE_ROWS=3
# Max tables to include in the schema context (0 = no limit).
INTROSPECT_MAX_TABLES=0
# Comma-separated database allowlist. Empty = every non-system database.
# Strongly recommended on servers with many databases (keeps context small).
INTROSPECT_DATABASES=
# Comma-separated substrings; tables whose name contains one are skipped
# (e.g. backup/test/old copies): backup,_test,_old,_shadow
INTROSPECT_EXCLUDE_TABLE_PATTERNS=

# --- Storage (Postgres) ---
# Orgs, users, sessions, and every org's memory/reports/dashboards live here.
# `docker compose up -d` starts a matching server on port 5433.
DATABASE_URL=postgresql+psycopg://datatalk:datatalk@localhost:5433/datatalk
# Separate database used by the test suite. Tests refuse to run if this equals
# DATABASE_URL, and skip entirely if it is unset.
DATATALK_TEST_DATABASE_URL=postgresql+psycopg://datatalk:datatalk@localhost:5433/datatalk_test
# Migrations are run explicitly with `datatalk-db upgrade`. Set true to run them
# on startup instead -- safe ONLY with a single process.
DATATALK_DB_AUTO_MIGRATE=false
# Connection pool. Defaults suit a single uvicorn worker; raise for more.
DATATALK_DB_POOL_SIZE=10
DATATALK_DB_MAX_OVERFLOW=20
# Echo every statement to the log. Very noisy -- debugging only.
DATATALK_DB_ECHO=false

# Legacy SQLite file. Read only by `datatalk-import-sqlite` when migrating
# pre-multi-tenant data into an org; unused at runtime.
DATATALK_DB_PATH=datatalk.sqlite3

# --- Secrets ---
# Encrypts every stored data source password at rest. REQUIRED. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated to rotate: the first key encrypts, all keys decrypt.
# Lose this and every org must re-enter its data source credentials.
DATATALK_SECRET_KEY=

# --- Auth ---
# !! Leave false on plain HTTP (including localhost). With it true over HTTP the
# !! browser silently discards the session cookie: login returns 200 and every
# !! following request 401s. Set true only when served over HTTPS.
DATATALK_COOKIE_SECURE=false
DATATALK_SESSION_TTL_DAYS=14
# Session cookie name. Change only to run two DataTalk instances on one host.
DATATALK_COOKIE_NAME=dt_session
# Anyone can create an account and their own org. Convenient for local dev.
# !! With this true a public deployment is an open relay to whatever warehouse
# !! a stranger configures, and an open spend vector on OPENAI_API_KEY above.
# !! Set false before exposing this app to a network.
DATATALK_ALLOW_OPEN_SIGNUP=true

# Optional idempotent bootstrap: creates this org + owner on startup if absent.
DATATALK_BOOTSTRAP_ORG_NAME=
DATATALK_BOOTSTRAP_ADMIN_EMAIL=
DATATALK_BOOTSTRAP_ADMIN_PASSWORD=

# --- Memory retrieval ---
# Upper bound on suggestion rows scored in Python per retrieval. An OOM guard a
# single org cannot defeat by adding suggestions.
DATATALK_MEMORY_MAX_CANDIDATES=5000

# --- Web / CORS ---
# Comma-separated browser origins allowed to call the API -- the Next.js
# frontend's origin. localhost and 127.0.0.1 are DIFFERENT origins to a browser,
# so list both. Empty = no CORS headers (same-origin only).
# Read at import time: changing this requires a server restart.
DATATALK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


