# --- Secrets / local config (contains real credentials) ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.egg

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Local data / app state ---
datatalk.sqlite3
*.sqlite3
*.db

# --- Test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store

.claude/settings.local.json

# --- Eval run artifacts ---
# `datatalk-eval run --out` writes a JSON record per run. The committed
# baseline (evals/baseline.md) is the number to compare against; the raw
# per-attempt JSON is a working file, not history.
evals/*.json
!evals/baseline.md
