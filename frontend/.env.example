# Frontend configuration. Copy to `.env.local` (gitignored) to override.
#
# Where the FastAPI backend lives. Baked in at build time -- NEXT_PUBLIC_* vars
# are inlined into the client bundle, so changing this needs a rebuild, and it
# must never hold a secret.
#
# Use `localhost`, NOT `127.0.0.1`. The session cookie is SameSite=Lax, and
# `localhost:3000 -> 127.0.0.1:8000` is cross-*site*: the browser withholds the
# cookie and every request 401s with nothing in either log. Whichever hostname
# you serve the UI on, match it here -- and list that origin in the backend's
# DATATALK_CORS_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
